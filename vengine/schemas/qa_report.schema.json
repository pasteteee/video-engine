{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa_report",
  "title": "QA report of a rendered episode",
  "type": "object",
  "required": ["video", "checks", "issues", "verdict"],
  "properties": {
    "video": {"type": "string"},
    "round": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {"id": {"type": "string"}, "status": {"enum": ["pass", "warn", "fail"]}, "details": {"type": "string"}}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at_s", "severity", "category", "description"],
        "properties": {
          "at_s": {"type": "number"},
          "severity": {"enum": ["blocker", "major", "minor"]},
          "category": {"enum": ["boredom", "sync", "typography", "fact", "source", "audio", "visual_glitch", "license", "pacing"]},
          "description": {"type": "string"},
          "found_by": {"enum": ["auto", "claude_frames", "gemini_video", "owner"]},
          "fix": {"type": "string"},
          "fixed": {"type": "boolean"}
        }
      }
    },
    "verdict": {"enum": ["ready", "needs_fixes", "blocked"]},
    "summary": {"type": "string"}
  }
}
