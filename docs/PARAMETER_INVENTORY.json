  "glossary": {
    "eye.closed80": "Both eyes >=80% closed relative to neutral; NaN if unreliable. Geometric proxy, not calibrated pupil occlusion.",
    "head.angular_speed_deg_s": "Euclidean norm of wrapped yaw/pitch/roll derivatives; degrees/s, not a rigid-body angular velocity.",
    "head.angular_accel_deg_s2": "Absolute change of angular speed per second; missing across gaps.",
    "face.present": "1 if a face was detected in the frame.",
    "face.reliability": "0..1; drops as the head turns away from the person's neutral pose (asymmetry and AU values degrade beyond ~20 deg yaw).",
    "head.yaw|pitch|roll": "Head angles vs camera, degrees. yaw>0 turned to the subject's left, pitch>0 chin up, roll>0 subject's left eye higher.",
    "head.*_rel": "Same angles relative to the person's own neutral head pose.",
    "eye.closure[_l|_r]": "0 = eye as open as in the neutral face, 1 = fully closed.",
    "au.AUxx": "Geometric proxy of a FACS action unit, intensity 0..1, relative to the person's neutral face. _l/_r are the subject's left/right sides. AU01 inner brow raiser; AU02 outer brow raiser; AU04 brow lowerer; AU05 upper lid raiser (eyes widen); AU06 cheek raiser (lower lid pushed up); AU07 lid tightener (squint); AU09 nose wrinkler; AU10 upper lip raiser; AU12 lip corner puller (smile); AU15 lip corner depressor; AU17 chin raiser; AU20 lip stretcher; AU23 lip tightener / presser; AU25 lips part; AU26 jaw drop",
    "expr.*": "0..1 similarity of the face configuration to a prototypical display (happiness, sadness, surprise, fear, anger, disgust, contempt). It describes visible muscle movement, not what the person feels.",
    "face.expressivity": "RMS of all action units: how far the face is from its neutral.",
    "smile.duchenne": "Smile with cheek raise (AU6+AU12), the 'eye-involving' smile.",
    "smile.social": "Lip-corner smile without cheek raise (AU12 without AU6).",
    "asym.mouth|brow": "-1..1, >0 means the subject's left side moved up more than the right.",
    "asym.eye": "-1..1, >0 means the right eye is more closed than the left.",
    "gaze.h|v": "Iris offset vs neutral, in half eye-widths. h>0 toward image right, v>0 up.",
    "gaze.dir_h_deg|dir_v_deg": "Approximate gaze direction (head + eyes) vs neutral, degrees.",
    "gaze.averted": "1 when the approximate gaze direction is more than 15 deg off neutral.",
    "mouth.activity": "Rolling std of lip opening (IOD units); high while talking.",
    "mouth.speaking": "1 when mouth movement looks like speech. Mouth AUs are less trustworthy while speaking.",
    "body.*": "Body positions are relative to the shoulder midpoint in shoulder widths (SW).",
    "body.lean_in": "Apparent torso size vs the person's typical size; >0 = leaning toward camera.",
    "body.shoulder_roll_rel": "Shoulder-line tilt vs typical, degrees; >0 = subject's left shoulder higher.",
    "body.lateral_lean_rel": "Torso sideways lean vs typical, degrees (needs hips in view).",
    "body.shrug": "0..1, shoulders raised toward the ears vs typical.",
    "body.hand_height_l|r": "Wrist height vs shoulder line in SW (>0 above the shoulders).",
    "body.gesture_speed": "Fastest wrist speed relative to the torso, SW per second.",
    "body.gesture_activity": "0..1 normalised gesture speed.",
    "body.gesturing": "1 while a hand moves faster than 0.6 SW/s.",
    "body.arm_openness": "Horizontal distance between wrists in SW; _rel is vs the person's typical.",
    "body.arms_crossed": "1 when the wrists are swapped across the body midline below the shoulders.",
    "body.hands_joined": "1 when the hands touch each other (clasping, steepling, wringing).",
    "body.face_touch": "1 when a hand is close to the face (self-touch / adaptor gesture).",
    "body.palm_to_camera": "-1..1, +1 palm facing the camera (needs hand landmarks).",
    "body.open_palms": "1 when at least one palm clearly faces the camera (not while arms are crossed or hands joined)."
  },
