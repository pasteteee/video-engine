{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings",
  "title": "Research findings: sources, facts, own calculations, conclusions",
  "type": "object",
  "required": ["sources", "facts", "conclusions"],
  "properties": {
    "sources": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "kind"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "publisher": {"type": "string"},
          "kind": {"enum": ["primary", "data", "secondary", "statistics", "encyclopedia"]},
          "accessed": {"type": "string"}
        }
      }
    },
    "facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "source_ids", "status"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "value": {"type": ["number", "string"]},
          "unit": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"enum": ["verified", "likely", "disputed", "rejected"]},
          "surprise": {
            "type": "object",
            "properties": {"expert": {"type": "boolean"}, "novice": {"type": "boolean"}}
          },
          "golden": {"type": "boolean"}
        }
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "result"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string"}, "description": "fact ids"},
          "method": {"type": "string"},
          "result": {"type": "string"},
          "script": {"type": "string"}
        }
      }
    },
    "conclusions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "based_on", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "based_on": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reasoning": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "counterpoint": {"type": "string"}
        }
      }
    }
  }
}
