{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shorts",
  "title": "Shorts plan: vertical-native cuts of the strongest moments",
  "type": "object",
  "required": ["width", "height", "shorts"],
  "properties": {
    "width": {"const": 1080},
    "height": {"const": 1920},
    "look": {"type": "object", "description": "Usually the episode look; may be pushed brighter for the feed"},
    "shorts": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "line_ids", "start_s", "end_s", "hook_text", "title", "shots"],
        "properties": {
          "id": {"type": "string"},
          "line_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "start_s": {"type": "number", "description": "In the episode voice track"},
          "end_s": {"type": "number"},
          "score": {"type": "number"},
          "why": {"type": "array", "items": {"type": "string"}},
          "hook_text": {"type": "string", "description": "1-6 words on screen from frame 0, before the voice lands"},
          "title": {"type": "string", "description": "YouTube Shorts title, <= 70 chars, the curiosity gap in plain words"},
          "loop_end": {"type": "string", "description": "How the last frame leads back into the first"},
          "shots": {
            "type": "array", "minItems": 3,
            "items": {
              "type": "object",
              "required": ["id", "layout", "start_s", "duration_s"],
              "properties": {
                "id": {"type": "string"},
                "from_shot": {"type": "string", "description": "Episode shot this one recomposes (media, params)"},
                "layout": {"type": "string", "pattern": "^v_", "description": "Vertical-native layout: v_photo_pan, v_photo_stack, v_film_crop, v_type, v_number, v_quote, v_map, v_custom"},
                "start_s": {"type": "number", "description": "Relative to the short"},
                "duration_s": {"type": "number", "exclusiveMinimum": 0},
                "media_ids": {"type": "array", "items": {"type": "string"}},
                "focus": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3, "description": "Image point (x, y fractions) the 9:16 crop follows, optional zoom"},
                "params": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
